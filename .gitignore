# ============================================================
# 剪辑师作品集 — Git 忽略规则
# 原则：只提交「源码 + 内容 + 文档」，不提交任何生成的、机器的、含密钥的文件
# 注意：.gitignore 不支持行尾注释，注释必须单独占一行
# ============================================================

# ---------- 1. 凭据与密钥（最重要，绝不能入库） ----------
# 管理员密码哈希，首次启动由 server.js 自动生成
portfolio/auth.json
# 环境变量文件（.env.example 是模板，文件名不同，不受影响）
.env
.env.local
.env.*.local

# ---------- 2. 运行时生成的日志与数据副本 ----------
# 访问日志，含访客 IP 与时间戳
portfolio/access-log.json
# 每次保存前自动生成的上一版备份
portfolio/data.json.bak
# 原子写临时文件
portfolio/data.json.tmp
# 解析失败时保留的损坏副本
portfolio/data.json.corrupt-*

# ---------- 3. 上传的媒体文件（体积大、由后台生成，非源码） ----------
portfolio/public/videos/*
!portfolio/public/videos/.gitkeep
# 后台上传的图片命名规则为「时间戳-名称.后缀」，据此排除，不影响原始素材
portfolio/public/images/[0-9]*-*.*
portfolio-spa/images/[0-9]*-*.*

# ---------- 4. 构建产物 ----------
# build_static.py 的输出目录
portfolio-static/
# SPA 单文件产物，由 build_spa.py 生成
# 若要用 GitHub Pages 直接托管、不想配 Actions，把这行注释掉即可改为提交
portfolio-spa/index.html

# ---------- 5. 依赖与缓存 ----------
node_modules/
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 6. 编辑器与操作系统 ----------
.vscode/
.idea/
*.suo
*.ntvs*
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ---------- 7. 打包临时文件 ----------
*.zip
*.tar.gz
