# 复制为 .env 后按需修改（本项目零依赖，不会自动读取 .env，
# 请以系统环境变量的方式注入，或用下面的命令临时测试）

# 监听端口，默认 3000
PORT=3000

# 监听地址。默认 127.0.0.1（仅本机）
# 部署到服务器并需要外网访问时才改为 0.0.0.0，且必须配合反向代理 + HTTPS
HOST=127.0.0.1

# 首次启动时写入的初始管理员密码（默认 admin123）
# 仅在 data.json 尚无密码哈希时生效；部署后请立即登录后台修改
ADMIN_PASSWORD=admin123

# 对外访问地址，用于 canonical / Open Graph（部署时改成真实域名，末尾带 /）
SITE_URL=https://example.com/

# 只有在 Nginx 等反向代理之后才设为 1；否则客户端可伪造 X-Forwarded-For 绕过登录限流
TRUST_PROXY=0

# 后台「发布上线」使用的 Python 路径；不在 PATH 时填完整路径
# PYTHON_BIN=C:\Python312\python.exe
